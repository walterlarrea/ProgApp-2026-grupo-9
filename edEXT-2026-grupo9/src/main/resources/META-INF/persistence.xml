<?xml version="1.0" encoding="UTF-8"?>
<persistence
    version="3.1"
    xmlns="https://jakarta.ee/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation=
        "https://jakarta.ee/xml/ns/persistence
        https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd">
  <persistence-unit
      name="edEXT_PU" transaction-type="RESOURCE_LOCAL">
    <provider>
        org.hibernate.jpa.HibernatePersistenceProvider
    </provider>

    <!-- Clases -->
    <class>com.grupo9.edext.grupo9.servidor_central.controller.edicion_de_curso.EdicionCurso</class>
    <class>com.grupo9.edext.grupo9.servidor_central.controller.edicion_de_curso.InscEdicion</class>
    <class>com.grupo9.edext.grupo9.servidor_central.controller.curso.Curso</class>
    <class>com.grupo9.edext.grupo9.servidor_central.controller.usuario.Usuario</class>
    <class>com.grupo9.edext.grupo9.servidor_central.controller.usuario.Estudiante</class>
    <class>com.grupo9.edext.grupo9.servidor_central.controller.usuario.Docente</class>
    <class>com.grupo9.edext.grupo9.servidor_central.controller.programa_de_formacion.ProgramaDeFormacion</class>

    <properties>
    <!--// Propiedades de MySQL y Connector/J, acá enlazamos con la base de datos -->
        <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
        <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/edEXT?serverTimezone=UTC"/> <!-- serverTimezone: para sincronizar a la zona horaria -->
        <property name="jakarta.persistence.jdbc.user" value="root"/>
        <property name="jakarta.persistence.jdbc.password" value=".mayonesa23."/>
    <!-- Propiedades de Hibernate para desarrollo -->
        <property name="hibernate.hbm2ddl.auto" value="update"/> <!-- para actualizar las tablas a partir de las entidades que tengamos acá, no inserta los datos automáticamente, no no -->
        <property name="hibernate.show_sql" value="true"/>
    </properties>
  </persistence-unit>
</persistence>
