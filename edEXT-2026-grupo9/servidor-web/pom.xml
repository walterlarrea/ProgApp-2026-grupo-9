<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.2026grupo9</groupId>
        <artifactId>edEXT-2026-grupo9</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>servidor-web</artifactId>
    <packaging>war</packaging>

    <name>edEXT :: Servidor Web (Tomcat / Servlets / JSP)</name>

    <dependencies>
        <!-- Jakarta Servlet API 6.0 (Tomcat 10.1+) -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta JSP API 3.1 -->
        <dependency>
            <groupId>jakarta.servlet.jsp</groupId>
            <artifactId>jakarta.servlet.jsp-api</artifactId>
            <version>3.1.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta JSTL -->
        <dependency>
            <groupId>jakarta.servlet.jsp.jstl</groupId>
            <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.web</groupId>
            <artifactId>jakarta.servlet.jsp.jstl</artifactId>
            <version>3.0.1</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.14.0</version>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.3.232</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.18.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.18.0</version>
            <scope>test</scope>
        </dependency>

        <!-- JAX-WS runtime -->
        <dependency>
            <groupId>jakarta.xml.ws</groupId>
            <artifactId>jakarta.xml.ws-api</artifactId>
            <version>4.0.2</version>
        </dependency>
        <dependency>
            <groupId>com.sun.xml.ws</groupId>
            <artifactId>jaxws-rt</artifactId>
            <version>4.0.3</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                    <webResources>
                        <resource>
                            <directory>src</directory>
                            <targetPath>WEB-INF</targetPath>
                            <includes>
                                <include>jax-ws-catalog.xml</include>
                                <include>wsdl/**</include>
                            </includes>
                        </resource>
                        <resource>
                            <directory>src</directory>
                            <targetPath>WEB-INF/classes/META-INF</targetPath>
                            <includes>
                                <include>jax-ws-catalog.xml</include>
                                <include>wsdl/**</include>
                            </includes>
                        </resource>
                    </webResources>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <jakarta.persistence.jdbc.url>jdbc:h2:mem:edext_test;DB_CLOSE_DELAY=-1</jakarta.persistence.jdbc.url>
                        <jakarta.persistence.jdbc.user>sa</jakarta.persistence.jdbc.user>
                        <jakarta.persistence.jdbc.password>edext_test</jakarta.persistence.jdbc.password>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- Plugin Cargo para ejecutar Tomcat 10 directamente con: mvn cargo:run -->
            <plugin>
                <groupId>org.codehaus.cargo</groupId>
                <artifactId>cargo-maven3-plugin</artifactId>
                <version>1.10.13</version>
                <configuration>
                    <container>
                        <containerId>tomcat10x</containerId>
                        <zipUrlInstaller>
                            <url>https://archive.apache.org/dist/tomcat/tomcat-10/v10.1.28/bin/apache-tomcat-10.1.28.zip</url>
                            <downloadDir>${project.basedir}/.cargo/downloads</downloadDir>
                            <extractDir>${project.basedir}/.cargo/extract</extractDir>
                        </zipUrlInstaller>
                    </container>
                    <configuration>
                        <properties>
                            <cargo.servlet.port>8080</cargo.servlet.port>
                        </properties>
                    </configuration>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.sun.xml.ws</groupId>
                <artifactId>jaxws-maven-plugin</artifactId>
                <version>4.0.3</version>
                <executions>
                    <execution>
                        <id>wsimport-programa-de-formacion</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>wsimport</goal>
                        </goals>
                        <configuration>
                            <wsdlFiles>
                                <wsdlFile>127.0.0.1_9128/programa_de_formacion.wsdl</wsdlFile>
                            </wsdlFiles>
                            <packageName>com.grupo9.edext.grupo9.servidor_web.web_service_client.programa_de_formacion</packageName>
                            <vmArgs>
                                <vmArg>-Djavax.xml.accessExternalSchema=all</vmArg>
                            </vmArgs>
                            <wsdlLocation>http://127.0.0.1:9128/programa_de_formacion?wsdl</wsdlLocation>
                            <staleFile>${project.build.directory}/jaxws/stale/programa_de_formacion.stale</staleFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>wsimport-curso</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>wsimport</goal>
                        </goals>
                        <configuration>
                            <wsdlFiles>
                                <wsdlFile>127.0.0.1_9128/curso.wsdl</wsdlFile>
                            </wsdlFiles>
                            <packageName>com.grupo9.edext.grupo9.servidor_web.web_service_client.curso</packageName>
                            <vmArgs>
                                <vmArg>-Djavax.xml.accessExternalSchema=all</vmArg>
                            </vmArgs>
                            <wsdlLocation>http://127.0.0.1:9128/curso?wsdl</wsdlLocation>
                            <staleFile>${project.build.directory}/jaxws/stale/curso.stale</staleFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>wsimport-edicion-de-curso</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>wsimport</goal>
                        </goals>
                        <configuration>
                            <wsdlFiles>
                                <wsdlFile>127.0.0.1_9128/edicion_de_curso.wsdl</wsdlFile>
                            </wsdlFiles>
                            <packageName>com.grupo9.edext.grupo9.servidor_web.web_service_client.edicion_de_curso</packageName>
                            <vmArgs>
                                <vmArg>-Djavax.xml.accessExternalSchema=all</vmArg>
                            </vmArgs>
                            <wsdlLocation>http://127.0.0.1:9128/edicion_de_curso?wsdl</wsdlLocation>
                            <staleFile>${project.build.directory}/jaxws/stale/edicion_de_curso.stale</staleFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>wsimport-instituto</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>wsimport</goal>
                        </goals>
                        <configuration>
                            <wsdlFiles>
                                <wsdlFile>127.0.0.1_9128/instituto.wsdl</wsdlFile>
                            </wsdlFiles>
                            <packageName>com.grupo9.edext.grupo9.servidor_web.web_service_client.instituto</packageName>
                            <vmArgs>
                                <vmArg>-Djavax.xml.accessExternalSchema=all</vmArg>
                            </vmArgs>
                            <wsdlLocation>http://127.0.0.1:9128/instituto?wsdl</wsdlLocation>
                            <staleFile>${project.build.directory}/jaxws/stale/instituto.stale</staleFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>wsimport-usuario</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>wsimport</goal>
                        </goals>
                        <configuration>
                            <wsdlFiles>
                                <wsdlFile>127.0.0.1_9128/usuario.wsdl</wsdlFile>
                            </wsdlFiles>
                            <packageName>com.grupo9.edext.grupo9.servidor_web.web_service_client.usuario</packageName>
                            <vmArgs>
                                <vmArg>-Djavax.xml.accessExternalSchema=all</vmArg>
                            </vmArgs>
                            <wsdlLocation>http://127.0.0.1:9128/usuario?wsdl</wsdlLocation>
                            <staleFile>${project.build.directory}/jaxws/stale/usuario.stale</staleFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>wsimport-busqueda</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>wsimport</goal>
                        </goals>
                        <configuration>
                            <wsdlFiles>
                                <wsdlFile>127.0.0.1_9128/busqueda.wsdl</wsdlFile>
                            </wsdlFiles>
                            <packageName>com.grupo9.edext.grupo9.servidor_web.web_service_client.busqueda</packageName>
                            <vmArgs>
                                <vmArg>-Djavax.xml.accessExternalSchema=all</vmArg>
                            </vmArgs>
                            <wsdlLocation>http://127.0.0.1:9128/busqueda?wsdl</wsdlLocation>
                            <staleFile>${project.build.directory}/jaxws/stale/busqueda.stale</staleFile>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <sourceDestDir>${project.build.directory}/generated-sources/jaxws-wsimport</sourceDestDir>
                    <xnocompile>true</xnocompile>
                    <verbose>true</verbose>
                    <extension>true</extension>
                    <catalog>${basedir}/src/jax-ws-catalog.xml</catalog>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
