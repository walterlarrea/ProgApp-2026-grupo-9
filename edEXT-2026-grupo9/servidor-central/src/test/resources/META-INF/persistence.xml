<?xml version="1.0" encoding="UTF-8"?>
<persistence
    version="3.1"
    xmlns="https://jakarta.ee/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd">
  <persistence-unit name="edEXT_PU" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>com.grupo9.edext.grupo9.servidor_central.controller.edicion_de_curso.EdicionCurso</class>
    <class>com.grupo9.edext.grupo9.servidor_central.controller.edicion_de_curso.InscEdicion</class>
    <class>com.grupo9.edext.grupo9.servidor_central.controller.curso.Curso</class>
    <class>com.grupo9.edext.grupo9.servidor_central.controller.instituto.Instituto</class>
    <class>com.grupo9.edext.grupo9.servidor_central.controller.usuario.Usuario</class>
    <class>com.grupo9.edext.grupo9.servidor_central.controller.usuario.Estudiante</class>
    <class>com.grupo9.edext.grupo9.servidor_central.controller.usuario.Docente</class>
    <class>com.grupo9.edext.grupo9.servidor_central.controller.programa_de_formacion.ProgramaDeFormacion</class>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
      <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:edext_test;DB_CLOSE_DELAY=-1"/>
      <property name="jakarta.persistence.jdbc.user" value="sa"/>
      <property name="jakarta.persistence.jdbc.password" value="edext_test"/>
      <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
      <property name="hibernate.show_sql" value="false"/>
    </properties>
  </persistence-unit>
</persistence>